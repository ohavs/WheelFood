rules_version = '2';

// WheelFood is a shared household list: everyone using the app reads and
// writes the same space. There is no per-person login, so the only gate is
// that a request carries an anonymous Firebase token — which the app obtains
// automatically. Anything under /spaces is therefore shared by design.
//
// /users is the pre-shared layout. It stays readable by its own owner so a
// device can migrate what it collected there into the shared space, and can
// be deleted once both devices have opened the app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /spaces/{spaceId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
