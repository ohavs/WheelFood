rules_version = '2';

// Every device signs in anonymously and owns exactly one document tree.
// Nothing is world-readable: a request must carry a token whose uid matches
// the path it is touching.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
